#!/bin/sh
# flickr on a Steam Deck: the helper first (sign-in, proxy, pad), then the
# QML client pointed at it, on flickr-deck-ui (Qt Quick with mpv in it). That
# one program is compiled, so the client runs in its Flatpak
# (deck/flatpak/): this script is the Flatpak's command, and run from
# SteamOS itself — where Steam's shortcut points — it hands over to it.
# Arguments go to helper.py (--upstream, --client-id, --no-pad).
APP=dev.kopsa.flickr.Deck
if [ -z "$FLATPAK_ID" ]; then
    exec flatpak run "$APP" "$@"
fi

here=$(dirname "$(readlink -f "$0")")
share=/app/share/flickr-deck
port_file=$(mktemp)
# The sign-in and the last profile live where they always have, not under
# ~/.var/app: the Flatpak is let at ~/.config/flickr-deck for that.
python3 "$share/helper.py" --state-dir "$HOME/.config/flickr-deck" "$@" >"$port_file" &
helper=$!
trap 'kill $helper 2>/dev/null; rm -f "$port_file"' EXIT INT TERM

i=0
while [ ! -s "$port_file" ] && [ $i -lt 100 ] && kill -0 $helper 2>/dev/null; do
    sleep 0.1; i=$((i + 1))
done
port=$(head -n 1 "$port_file")
[ -n "$port" ] || { echo "flickr-deck: the helper did not start" >&2; exit 1; }

# Game Mode's compositor hands games an X server, not a Wayland shell.
[ -n "$GAMESCOPE_WAYLAND_DISPLAY" ] && export QT_QPA_PLATFORM=xcb
export FLICKR_DECK_SHADERS="$share/shaders/mpv"
# FLICKR_UPSCALE=fsrcnnx or =artcnn starts the player on that network, =0 with
# upscaling off; FSR 1 otherwise. Up cycles them in the player.
"$here/flickr-deck-ui" "$share/Main.qml" -- "http://127.0.0.1:$port" "upscale=${FLICKR_UPSCALE:-fsr}"
