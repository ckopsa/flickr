MINIO_ENDPOINT=192.168.1.40:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=jellyfin-media
# The PUBLIC MinIO host playback URLs are signed for (README "Run"). Unset,
# they are signed for MINIO_ENDPOINT, which a phone off the LAN cannot fetch.
MINIO_PUBLIC_ENDPOINT=
# 8080 is occupied on this machine
LISTEN_ADDR=:8099
# Rescan interval (Go duration, e.g. "12h", "30m"; "0" disables the scheduler).
# An initial scan always runs on startup when the library is empty.
SCAN_INTERVAL=12h
# TMDB API key for metadata enrichment (posters, overviews).
# Leave empty to disable the enrichment stage entirely.
TMDB_API_KEY=
# Transcription (README 18): a whisper.cpp CLI and a ggml model file. Both
# empty is the stage off; with both, every video or audio file that carries no
# subtitles of its own gets a generated WebVTT track.
TRANSCRIBE=
WHISPER_MODEL=
# The language to transcribe in; empty (or "auto") lets whisper detect it.
WHISPER_LANGUAGE=
# Sign-in (README "Signing in", cmd/server/auth.go). Empty OIDC_ISSUER is
# the whole thing off: no /auth/ routes, no gate, every address as it was.
# With an issuer, OIDC_CLIENT_ID and a 32-byte OIDC_SESSION_SECRET are
# required or the server refuses to start.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The PUBLIC origin the callback is under; defaults to ADVERTISE_URL.
OIDC_APP_URL=
# Signs the session cookie. Generate with: openssl rand -base64 48
OIDC_SESSION_SECRET=
# "0" offers sign-in and gates nothing — the staged rollout.
OIDC_REQUIRE_AUTH=1
# Comma-separated extra audiences a bearer token may carry (an agent's or an
# MCP client's own client id).
OIDC_DELEGATE_CLIENTS=
