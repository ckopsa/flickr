MINIO_ENDPOINT=192.168.1.40:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=jellyfin-media
# 8080 is occupied on this machine
LISTEN_ADDR=:8099
# Rescan interval (Go duration, e.g. "12h", "30m"; "0" disables the scheduler).
# An initial scan always runs on startup when the library is empty.
SCAN_INTERVAL=12h
# TMDB API key for metadata enrichment (posters, overviews).
# Leave empty to disable the enrichment stage entirely.
TMDB_API_KEY=
